# Development only. Copy to .env and set non-secret local values.
APP_ENV=development
DATABASE_URL=sqlite:///./tmp/jaldirshti.db
AUTH_MODE=development
STORAGE_BACKEND=local
STORAGE_BUCKET=jaldirshti-evidence
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For local PostGIS, set POSTGRES_PASSWORD in your shell and use a matching
# PostgreSQL URL in your untracked .env file.
# Production requires AUTH_MODE=oidc, OIDC_ISSUER, OIDC_AUDIENCE, a secret manager,
# private object storage, and PostgreSQL with PostGIS. Never commit production values.
